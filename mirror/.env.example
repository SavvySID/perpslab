# Bot key you linked in the dreamDEX app (Link a bot, Perps ticked). Testnet only, never your main wallet.
PRIVATE_KEY=0x...
# The wallet that linked the bot. Its perps account is where copies land. Use a dedicated wallet (Wallet 2 or 3).
FOLLOWER=0x...
# The trader to copy. Check them first with: npm run inspect -- 0x...
LEADER=0x...
# auto = your equity / leader equity, or a fixed multiple of the leader's size such as 0.05
SCALE=auto
# false = copy only trades the leader makes after Mirror starts; true = also open copies of positions they already hold
COPY_EXISTING=false
# Largest position Mirror will hold per market, in USDso notional
MAX_NOTIONAL_USDSO=250
# How far past the mark an IOC copy order may fill, in basis points (100 = 1%)
SLIPPAGE_BPS=100
# Optional comma-separated allowlist, e.g. BTC,ETH,SOL
MARKETS=
# Full re-check of both accounts every N seconds, on top of the live Reactivity feed
RECONCILE_SEC=20
# Opening orders per hour before Mirror stops adding exposure (closes still go through)
MAX_ORDERS_PER_HOUR=60
# true = log what it would do and send nothing
DRY_RUN=true
PORT=8787
